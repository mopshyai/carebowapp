# CareBow Environment Variables
# Copy this file to .env and fill in your values.
#
# These are read via `import { X } from '@env'` (react-native-dotenv, wired up
# in babel.config.js). They are inlined at BUILD time, so:
#   - process.env.X does NOT work in React Native. Import from '@env'.
#   - changing .env requires a Metro restart with --reset-cache to take effect.
#   - every value here ends up in the shipped bundle. Nothing secret goes in it.
# Add new keys to src/types/env.d.ts too, or TypeScript will not see them.

# App Configuration
APP_ENV=development
APP_NAME=CareBow

# API Configuration
#
# Mobile has one CareBow backend boundary: API_BASE_URL + /v1/...
# Keep the base unversioned so endpoint modules own the `/v1` prefix uniformly.
# The `www` is mandatory: the bare domain redirects and React Native may drop a
# POST body while following that redirect.
API_BASE_URL=https://www.carebow.com/api
API_TIMEOUT=30000

# No OpenAI/Razorpay/Ask CareBow server keys belong in this file. Public mobile
# builds contain these values verbatim; privileged integrations terminate at
# carebow-main and are reached through authenticated /api/v1 routes.

# Analytics (optional)
ANALYTICS_KEY=

# Sentry Error Tracking (optional)
# Leave blank to disable crash reporting.
SENTRY_DSN=

# Feature Flags
FEATURE_HEALTH_MEMORY=true
FEATURE_IMAGE_UPLOAD=true
FEATURE_VOICE_INPUT=true
