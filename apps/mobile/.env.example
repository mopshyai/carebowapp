# CareBow Environment Variables
# Copy this file to .env and fill in your values.
#
# These are read via `import { X } from '@env'` (react-native-dotenv, wired up
# in babel.config.js). They are inlined at BUILD time, so:
#   - process.env.X does NOT work in React Native. Import from '@env'.
#   - changing .env requires a Metro restart with --reset-cache to take effect.
#   - every value here ends up in the shipped bundle. Nothing secret goes in it.
# Add new keys to src/types/env.d.ts too, or TypeScript will not see them.

# App Configuration
APP_ENV=development
APP_NAME=CareBow

# API Configuration
#
# No version suffix. Endpoints carry their own prefix because the app calls both
# versioned (/v1/auth/login) and unversioned (/auth/enabled-methods,
# /ask-carebow/message) paths. A base URL ending in /v1 double-prefixes the first
# group and breaks the second.
#
# The `www` is mandatory: the bare domain 302/307-redirects to www and React
# Native's fetch drops POST bodies on redirect.
API_BASE_URL=https://www.carebow.com/api
API_TIMEOUT=30000

# Ask CareBow AI Configuration
ASK_CAREBOW_API_URL=https://www.carebow.com/api/ask-carebow
ASK_CAREBOW_API_KEY=

# Analytics (optional)
ANALYTICS_KEY=

# Sentry Error Tracking (optional)
# Leave blank to disable crash reporting. A blank DSN means Sentry.init is a
# no-op — which is what shipped before this was wired to '@env'.
SENTRY_DSN=

# Feature Flags
FEATURE_HEALTH_MEMORY=true
FEATURE_IMAGE_UPLOAD=true
FEATURE_VOICE_INPUT=true
