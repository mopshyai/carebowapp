{
  "name": "carebow",
  "version": "1.0.0",
  "private": true,
  "description": "Healthcare at your fingertips - A modern React Native healthcare companion app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mopshyai/carebowapp.git"
  },
  "author": "CareBow Inc.",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@carebow/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:coverage": "turbo run test -- --coverage",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "check:api-boundary": "node scripts/check-mobile-api-boundary.mjs",
    "ios": "pnpm --filter @carebow/mobile ios",
    "android": "pnpm --filter @carebow/mobile android",
    "pod-install": "pnpm --filter @carebow/mobile pod-install",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "standard-version": "^9.5.0",
    "turbo": "^2.7.5",
    "turbo-darwin-arm64": "^2.7.5",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "xmldom": "npm:@xmldom/xmldom@0.9.12",
      "xml2js@<0.5.0": "0.5.0",
      "minimatch@>=3.0.0 <3.1.4": "3.1.4",
      "minimatch@>=8.0.0 <8.0.6": "8.0.6",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "ajv@>=6.0.0 <6.14.0": "6.14.0",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "flatted@<3.4.2": "3.4.2",
      "handlebars@>=4.0.0 <4.7.9": "4.7.9",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "node-forge@>=1.0.0 <1.4.0": "1.4.0",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "lodash@>=4.0.0 <4.18.0": "4.18.0",
      "turbo@>=2.0.0 <2.9.14": "2.9.14",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": "7.29.4",
      "shell-quote@>=1.0.0 <1.9.0": "1.9.0",
      "tmp@>=0.2.0 <0.2.7": "0.2.7",
      "joi@>=17.0.0 <17.13.4": "17.13.4",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "ws@>=6.0.0 <6.2.4": "6.2.4",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "decode-uri-component@<0.5.0": "0.5.0",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  }
}
